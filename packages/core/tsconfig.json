{
  // The package on its own, with the least a JavaScript engine promises. No Node and no DOM
  // types, so a use of `Buffer`, `window` or `process` in portable code stops the build here
  // instead of in whoever builds the phone application. The tests are left out because they
  // run under Node, which is checked by the desktop project that includes them.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "portable-globals.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
