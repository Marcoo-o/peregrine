{
  // The package on its own, with the least a JavaScript engine promises, like packages/core and
  // packages/imap. No Node and no DOM types: the client is written against a transport it is given.
  // The tests are left out because they run under Node, which the desktop project checks.
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": [],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts", "portable-globals.d.ts"],
  "exclude": ["src/**/*.test.ts"]
}
